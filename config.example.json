{
  "port": 3000,
  "broadcaster_id": "YOUR_BROADCASTER_ID",
  "broadcaster_name": "YOUR_TWITCH_USERNAME",
  "twitch": {
    "client_id": "YOUR_TWITCH_CLIENT_ID",
    "client_secret": "YOUR_TWITCH_CLIENT_SECRET"
  },
  "ssn": {
    "session_id": "YOUR_SSN_SESSION_ID",
    "server": "wss://io.socialstream.ninja"
  },
  "twitch_refresh_minutes": 10,
  "days_filter": 30,
  "active_subs_only": false,
  "hashtags_enabled": true,
  "chat_log_enabled": true,
  "exclude_users": [],
  "banned_users": [],
  "auto_backup_on_session_end": false,
  "theme": {
    "font_family": "Jersey 20",
    "font_import": "https://fonts.googleapis.com/css2?family=Jersey+20&display=swap",
    "text_color": "rgb(214, 227, 225)",
    "accent_color": "rgb(255, 255, 255)",
    "background_color": "transparent",
    "text_outline": true,
    "text_outline_color": "#00000066",
    "font_scale": 1
  },
  "webhooks": {
    "enabled": false,
    "discord_url": "",
    "events": [
      "raid",
      "subscribe",
      "donation",
      "bits",
      "follow"
    ],
    "batch_seconds": 5
  },
  "rate_limit": {
    "enabled": false,
    "requests_per_minute": 120,
    "mutation_per_minute": 30
  },
  "music": {
    "enabled": false,
    "source": "apple_music",
    "poll_seconds": 5
  },
  "viewer_tracking": {
    "enabled": true,
    "source": "best_available",
    "poll_seconds": 60,
    "retain_samples": 720
  },
  "goals": {
    "enabled": true,
    "rotate_seconds": 8,
    "skip_completed": true,
    "pause_completed_seconds": 0,
    "items": [
      {
        "id": "follower-goal",
        "enabled": true,
        "title": "Follower Goal",
        "type": "followers",
        "target": 25,
        "tracking": "persistent",
        "baseline": 0
      },
      {
        "id": "viewer-goal",
        "enabled": false,
        "title": "Peak Viewers Goal",
        "type": "viewers",
        "target": 50,
        "tracking": "session",
        "viewer_mode": "peak"
      },
      {
        "id": "community-goal",
        "enabled": false,
        "title": "Community Goal",
        "type": "community",
        "target": 100,
        "tracking": "persistent",
        "baseline_metrics": {
          "followers": 0,
          "subscribers": 0,
          "gift_subs": 0,
          "bits": 0,
          "donations": 0
        },
        "weights": {
          "followers": 1,
          "subscribers": 5,
          "gift_subs": 5,
          "bits_per_100": 1,
          "donations": 1
        }
      }
    ]
  },
  "credits": {
    "header": {
      "image": "",
      "title": "Thank you for your support!",
      "subtitle": ""
    },
    "closing": "Thanks for watching!",
    "closing_display_style": "scroll",
    "closing_display_duration": 0,
    "sections": {
      "subscribers": {
        "enabled": true,
        "title": "Subscribers",
        "subtitle": ""
      },
      "followers": {
        "enabled": true,
        "title": "New Followers",
        "subtitle": ""
      },
      "donations": {
        "enabled": true,
        "title": "Donators",
        "subtitle": "",
        "source": "session"
      },
      "gift_subs": {
        "enabled": true,
        "title": "Gift Subs",
        "subtitle": ""
      },
      "cheerers": {
        "enabled": true,
        "title": "Cheerers",
        "subtitle": "",
        "source": "session"
      },
      "raids": {
        "enabled": true,
        "title": "Raiders",
        "subtitle": ""
      },
      "emotes": {
        "enabled": true,
        "title": "Top Emotes",
        "subtitle": ""
      },
      "hashtags": {
        "enabled": true,
        "title": "Trending Hashtags",
        "subtitle": ""
      },
      "chatters": {
        "enabled": true,
        "title": "Today's Chatters",
        "subtitle": ""
      }
    },
    "section_order": [
      "subscribers",
      "followers",
      "custom-community-awards",
      "donations",
      "gift_subs",
      "cheerers",
      "raids",
      "emotes",
      "hashtags",
      "chatters",
      "special_thanks"
    ],
    "special_thanks": {
      "enabled": false,
      "title": "Special Thanks",
      "subtitle": "",
      "columns": 1,
      "display_style": "scroll",
      "display_duration": 0,
      "names": []
    },
    "custom_sections": [
      {
        "id": "custom-community-awards",
        "enabled": false,
        "title": "Community Awards",
        "subtitle": "",
        "body": "Optional statement text goes here.",
        "columns": 1,
        "display_style": "fade",
        "display_duration": 0,
        "names": [
          "Best Clip Finder",
          "Chaos Coordinator"
        ]
      }
    ],
    "social": {
      "title": "Thanks for watching!",
      "subtitle": "",
      "links": []
    }
  }
}